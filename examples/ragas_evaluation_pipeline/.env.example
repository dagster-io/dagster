# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
# `dagster dev` auto-loads `.env` from the project root — no manual export needed.

# --- Scoring backend ---------------------------------------------------------
# "deterministic" (default, offline, no key) or "ragas" (real RAGAS via Groq).
RAGAS_SCORER=deterministic

# --- Groq (only needed when RAGAS_SCORER=ragas) ------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the Groq judge model (default: llama-3.3-70b-versatile)
# RAGAS_LLM_MODEL=llama-3.3-70b-versatile
